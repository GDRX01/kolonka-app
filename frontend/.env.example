# Leave empty in development (Vite proxies /api to Laravel).
# In production, if the API lives on another domain, set e.g.:
# VITE_API_URL=
# Only if the API is on another domain than the site: the API's address WITHOUT /api, e.g. https://api.example.com
# (cover photos are loaded from <this value>/api/covers/...)
VITE_ASSET_URL=https://api.example.com/api
VITE_API_URL=
